# FAH-Adblock – Einstellungen für den Container (einmalig anpassen)
# IP-Adresse des NAS im Heimnetz – darauf lauscht der DNS-Dienst (UDP/TCP 53)
DNS_BIND=192.168.1.23
DNS_PORT=53
# Port der Weboberfläche (Portautomatik sucht bei Erstinstallation einen freien)
WEB_PORT=8053
# Gateway für lokale Namen (*.example.org, Gerätenamen, Rückwärtsauflösung)
GATEWAY=192.168.1.1
# Nur diese Netze dürfen fragen (kein offener Resolver)
ERLAUBTE_NETZE=192.168.1.0/24,192.168.5.0/24,127.0.0.1/32
TZ=Europe/Berlin
# leer = wird beim ersten Start zufällig erzeugt und in data/.geheimnis gemerkt
SESSION_SECRET=
# Reverse-Proxy vor der Weboberfläche (z. B. Nginx Proxy Manager): Adresse oder Netz des Proxys, damit die
# Anmeldebremse je echter Absenderadresse (X-Forwarded-For) zählt statt je Proxy. Leer = aus.
# Auch in der Oberfläche unter Einstellungen → Netz → „Vertraute Proxys“ einstellbar (dort hat Vorrang, was gespeichert ist).
VERTRAUTE_PROXIES=
